rules_version = '2';

// Crew ID images. Anyone may upload a valid image (intake is unauthenticated),
// but only admins can read/list/modify them. The server reads via the Admin SDK,
// which bypasses these rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{projectId}/{crewId}/{fileName} {
      allow read, list, update, delete:
        if request.auth != null && request.auth.token.admin == true;
      allow create:
        if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
