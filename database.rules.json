{
  "rules": {
    ".read": false,
    ".write": false,

    "crew": {
      ".read": "auth != null && auth.token.admin === true",
      ".indexOn": ["createdAt"],
      "$crewId": {
        ".read": "auth != null && auth.token.admin === true",
        ".write": "auth != null && auth.token.admin === true",
        ".validate": "newData.hasChildren(['id', 'personal', 'documents', 'contract'])"
      }
    },

    "projects": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    },

    "contracts": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    },

    "audit": {
      ".read": "auth != null && auth.token.admin === true"
    },

    "signTokens": {
      ".read": false,
      ".write": false
    },

    "signRefs": {
      ".read": false,
      ".write": false
    },

    "inboxProcessed": {
      ".read": false,
      ".write": false
    }
  }
}
