# ============================================================================
# Bayanati — Environment configuration
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local`. NEXT_PUBLIC_* values are exposed to the browser
# (this is fine and expected for Firebase web config); everything else is
# server-only and must stay secret.
# ============================================================================

# --- App -------------------------------------------------------------------
# Public base URL of the deployed app (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Firebase Web SDK (client) ---------------------------------------------
# From Firebase console → Project settings → General → "Your apps" (Web app).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=oep-crew-system.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=oep-crew-system
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://oep-crew-system-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=oep-crew-system.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server) -------------------------------------------
# From Firebase console → Project settings → Service accounts →
# "Generate new private key". Paste the three values below.
# The private key must keep its literal \n newlines when pasted on one line.
FIREBASE_ADMIN_PROJECT_ID=oep-crew-system
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@oep-crew-system.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# --- Admin access ----------------------------------------------------------
# Comma-separated list of emails allowed into /crew/dashboard.
ADMIN_EMAILS=saad@overexposure.ae,abdullah@overexposure.ae

# --- Google Drive API ------------------------------------------------------
# From Google Cloud console → APIs & Services → Credentials (OAuth 2.0).
# Run `npm run drive:auth` (or the guide in DEPLOYMENT.md) once to mint the
# refresh token for the account that owns the OEP Drive folder.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# ID of the top-level "Over Exposure Productions" Drive folder (from its URL).
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Email OUT (SMTP via Nodemailer) ---------------------------------------
# Contracts are emailed from here with the PDF attached. For Hostinger email use
# smtp.hostinger.com:465 (secure).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=crew@overexposure.ae
SMTP_PASS=
EMAIL_FROM="Over Exposure Productions <crew@overexposure.ae>"
# Where crew replies should land. Defaults to SMTP_USER — only set this if
# replies must go to a DIFFERENT mailbox than the one that sends.
# EMAIL_REPLY_TO=crew@overexposure.ae

# --- Email IN (IMAP — signed scans replied back) ---------------------------
# The app watches this mailbox and files any reply that carries a scanned PDF of
# a signed contract. All four values default to the SMTP ones above with the
# host's "smtp." swapped for "imap.", so on Hostinger you usually need none of
# them. Set them only if the receiving mailbox differs.
# IMAP_HOST=imap.hostinger.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=crew@overexposure.ae
# IMAP_PASS=
# IMAP_MAILBOX=INBOX
# Optional: move handled replies out of the inbox into this folder.
# IMAP_PROCESSED_MAILBOX=Filed contracts

# How often the running app checks that mailbox, in minutes. Default 5.
# Set to 0 to turn the in-process check off and drive /api/inbox/poll from cron
# instead (recommended if the app ever runs more than one instance).
# INBOX_POLL_INTERVAL_MINUTES=5
# Shared secret so a cron job can call the poll endpoint without logging in:
#   curl -s "https://<your-app>/api/inbox/poll?key=<this value>"
INBOX_POLL_SECRET=
